# R
.Rproj.user
.Rhistory
.RData
.Ruserdata
*.Rproj
..Rcheck/
*.tar.gz
*.tgz

# renv: the lockfile is tracked, the library is not
renv/library/
renv/local/
renv/cellar/
renv/python/
renv/sandbox/
renv/staging/

# rendered stage output (exemplars are added explicitly with -f)
reports/

# Working material: drafts, meeting notes, prior-run archives. Not governing
# (CLAUDE.md 14), deny-listed in .claude/settings.json, and holds binaries.
# Untracked by default -- delete this line to version it.
internal_docs/working/

# Quarto intermediates must never enter the source tree
/*_files/
/*.html
!README.html
.quarto/

# Local-only: third-party source extractions, not ours to publish (CLAUDE.md 3)
internal_docs/source/

# A guard, not a live path. A spec carrying a real state's policy values must
# not sit in inst/specs/, which el_spec_files() enumerates and which ships.
inst/specs/NJ_elp_2023.R

# Saved stage results. Student-level by design (check2 $flags/$profile), so
# never committed and never shared -- the documents in reports/ are the
# shareable artifact (R/disclosure.R).
results/

# Claude Code's per-machine permission list: local paths and scratch
# directories, never shared. The shared settings are .claude/settings.json.
.claude/settings.local.json

# Windows shortcuts carry this machine's absolute paths and host name.
*.lnk
